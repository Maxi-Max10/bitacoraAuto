{
  "name": "bitacora-auto",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "start": "node --env-file=.env.local scripts/dev.js",
    "dev": "npm run build && npm start",
    "db:migrate": "node --env-file=.env.local scripts/migrate.js",
    "build": "npm run check && node scripts/prepare-production.js && esbuild src/cloud.js --bundle --format=esm --minify --outfile=dist/cloud.js",
    "test": "node --test --test-isolation=none tests/*.test.js",
    "check": "node scripts/check.js"
  },
  "dependencies": {
    "@vercel/blob": "^2.8.2",
    "better-auth": "^1.7.16",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  },
  "overrides": {"zod":"^4.6.6"}
}
