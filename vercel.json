{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci --include=dev",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "regions": ["gru1"],
  "headers": [
    {"source":"/illustrations/(.*).png","headers":[{"key":"Cache-Control","value":"public, max-age=31536000, immutable"}]},
    {"source":"/compartir/:token","headers":[{"key":"Cache-Control","value":"no-store"},{"key":"Referrer-Policy","value":"no-referrer"},{"key":"X-Robots-Tag","value":"noindex, nofollow"}]}
  ],
  "rewrites": [{"source":"/api/:path*","destination":"/api/index?__route=:path*"},{"source":"/compartir/:token","destination":"/shared.html"}],
  "functions": {"api/**/*.js": {"maxDuration": 60}}
}
