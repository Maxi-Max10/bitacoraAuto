{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci --include=dev",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "regions": ["gru1"],
  "headers": [{"source":"/illustrations/(.*).png","headers":[{"key":"Cache-Control","value":"public, max-age=31536000, immutable"}]}],
  "rewrites": [{"source":"/api/:path*","destination":"/api/index?__route=:path*"}],
  "functions": {"api/**/*.js": {"maxDuration": 60}}
}
